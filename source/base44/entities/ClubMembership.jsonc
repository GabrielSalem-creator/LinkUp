{
  "name": "ClubMembership",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "user_name": {
      "type": "string",
      "description": "User display name"
    },
    "club_id": {
      "type": "string",
      "description": "Club ID"
    },
    "club_name": {
      "type": "string",
      "description": "Club name for display"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "admin"
      ],
      "default": "member"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_email",
    "club_id"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": true,
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}