{
  "name": "League",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sport": {
      "type": "string",
      "enum": [
        "running_walking",
        "biking",
        "swimming"
      ],
      "description": "running_walking counts running and walking activities"
    },
    "description": {
      "type": "string"
    },
    "created_by": {
      "type": "string",
      "description": "Email of creator"
    },
    "creator_name": {
      "type": "string"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique code to join this league"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "completed"
      ],
      "default": "upcoming"
    },
    "max_members": {
      "type": "number",
      "default": 50,
      "description": "Max 50 members"
    },
    "member_count": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name",
    "sport",
    "start_date",
    "end_date"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}