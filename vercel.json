{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix ./mobile install",
  "buildCommand": "npm --prefix ./mobile run build",
  "outputDirectory": "mobile/dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
